---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Topbar from '../../components/Topbar.astro';
import SideNav from '../../components/SideNav.astro';
import Toc from '../../components/Toc.astro';
import Infobox from '../../components/Infobox.astro';
import Deck from '../../components/Deck.astro';
import { TRACK_LABEL, TYPE_LABEL } from '../../taxonomy';

export async function getStaticPaths() {
  // draft 글은 prod 빌드(공개)에서 제외, dev 에서는 보여 작성자가 채운다.
  const entries = await getCollection('guide', ({ data }) => (import.meta.env.PROD ? !data.draft : true));
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry, entries } }));
}

const { entry, entries } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
const track = TRACK_LABEL[d.track];
const type = TYPE_LABEL[d.type];

// 같은 series 안에서 읽는 순서를 만든다 — 한 편을 읽고 다음이 어디인지 알 수 있게.
const sameSeries = d.series
  ? entries
      .filter((e) => e.data.series === d.series && e.data.track === d.track)
      .sort((a, b) => (a.data.order ?? 100) - (b.data.order ?? 100))
  : [];
const seriesIdx = sameSeries.findIndex((e) => e.id === entry.id);
const prev = seriesIdx > 0 ? sameSeries[seriesIdx - 1] : null;
const next = seriesIdx >= 0 && seriesIdx < sameSeries.length - 1 ? sameSeries[seriesIdx + 1] : null;
---

<Base title={`${d.title} — Fieldwork`}>
  <Topbar crumbCategory={track.ko} crumbTitle={d.title} present={true} />
  <div class="shell">
    <SideNav entries={entries} activeId={entry.id} />
    <main class="main">
      <p class="kick">{track.num} {track.ko} · {type.ko}</p>
      <h1>{d.title}</h1>
      {d.lead && <p class="lead">{d.lead}</p>}
      <div class="prose">
        <Content />
      </div>

      {sameSeries.length > 1 && (
        <nav class="ser-nav" aria-label="시리즈 안에서 이동">
          <p class="sn-h">{d.series} · {seriesIdx + 1}번째 / {sameSeries.length}편</p>
          <div class="sn-links">
            {prev ? (
              <a class="sn-item" href={`/guide/${prev.id}`}><span>← 이전</span><b>{prev.data.title}</b></a>
            ) : (
              <span class="sn-item sn-none"><span>← 이전</span><b>여기가 처음입니다</b></span>
            )}
            {next ? (
              <a class="sn-item sn-next" href={`/guide/${next.id}`}><span>다음 →</span><b>{next.data.title}</b></a>
            ) : (
              <span class="sn-item sn-next sn-none"><span>다음 →</span><b>여기가 마지막입니다</b></span>
            )}
          </div>
        </nav>
      )}
    </main>
    <aside class="toc" aria-label="문서 정보·차례">
      <Infobox
        track={d.track}
        type={d.type}
        basis={d.basis}
        stage={d.stage}
        updated={d.updated}
        verified={d.verified}
        reviewBy={d.review_by}
        related={d.related}
      />
      <div class="doc-toc"><Toc headings={headings} /></div>
    </aside>
  </div>
  <Deck slides={d.slides} />
</Base>
