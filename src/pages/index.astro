---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { buildNav, type TrendItem } from '../nav';
import trends from '../../content/trends/index.json';
import { digestTrends, isRelease } from '../trends';

// draft 글은 prod 빌드(공개)에서 제외, dev 에서는 보인다.
const entries = await getCollection('guide', ({ data }) => (import.meta.env.PROD ? !data.draft : true));
const groups = buildNav(entries);
const allTrends = (trends.items || []) as TrendItem[];
const dg = digestTrends(allTrends);
const topTopics = dg.topics.slice(0, 6);
// 미리보기엔 릴리스 태그 말고 실속 항목만
const recent = allTrends.filter((it) => !isRelease(it)).slice(0, 3);

// 트랙 설명은 src/taxonomy.ts 가 단일 출처(g.desc).
---

<Base title="AX Field Guide">
  <header class="topbar">
    <a class="brand" href="/">AX&nbsp;Field&nbsp;Guide<span class="dot">.</span></a>
    <nav class="topnav">
      {groups.map((g) => (g.firstHref ? <a href={g.firstHref}>{g.short}</a> : <span class="muted">{g.short}</span>))}
      <a href="/trends">동향</a>
    </nav>
  </header>

  <div class="wrap">
    <section class="hero">
      <p class="kick">공개 작업 노트 · 진행 중</p>
      <h1>AI를 <span class="q">도입</span>하는 일이 아니라, 판단 구조를 <span class="q">다시 설계</span>하는 일.</h1>
      <p class="sub">에이전트에게 일을 넘기는 법부터 AX·명세·1인 운영·지식 시스템까지, 직접 해본 것만 기록합니다. 전 범위를 가르치는 곳이 아니라, 끝까지 갈 수 있는 하나의 경로를 남깁니다.</p>
      <div class="cta">
        <a class="pri" href="/guide/what-is-ax">AX란 무엇인가 읽기 →</a>
        <a class="sec" href="/trends">최근 동향 보기</a>
      </div>
    </section>

    <p class="sec-t">어디서부터 볼까</p>
    <div class="cards">
      {groups.map((g) => {
        const head = (
          <div class="c-h">
            <b>{g.num} {g.ko}</b>
            <span class="en">{g.en}</span>
            <span class="cnt">{g.count > 0 ? g.count : '예정'}</span>
          </div>
        );
        return g.firstHref ? (
          <a class="card" href={g.firstHref}>{head}<p>{g.desc}</p></a>
        ) : (
          <div class="card card-soon">{head}<p>{g.desc}</p></div>
        );
      })}
      <a class="card" href="/trends">
        <div class="c-h"><b>동향</b><span class="en">Trends</span><span class="cnt">자동</span></div>
        <p>매일 자동 수집·요약하는 AX 기술 동향.</p>
      </a>
    </div>

    <p class="sec-t">최근 동향</p>
    <section class="trends">
      <div class="t-h"><span class="live"></span> 매일 자동 수집 · 주제로 묶어 봄</div>
      {topTopics.length > 0 && (
        <div class="t-topics">
          {topTopics.map((t) => (<a class="t-topic" href="/trends"><span>{t.label}</span><i>{t.count}</i></a>))}
        </div>
      )}
      <ul>
        {recent.map((it) => (
          <li>
            <div class="meta"><span class="src">{it.source}</span> · {it.date}</div>
            <a class="ti" href={it.url} target="_blank" rel="noopener">{it.title}</a>
          </li>
        ))}
      </ul>
      <a class="t-more" href="/trends">동향 전체 풍경 보기 →</a>
    </section>

    <footer class="site-footer">
      AX Field Guide — 판단 기준을 쌓아가는 작업 노트. · <a href="/guide/what-is-ax">읽기 시작 →</a>
    </footer>
  </div>
</Base>
