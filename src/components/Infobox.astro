---
import { TRACK_LABEL, TYPE_LABEL, BASIS_LABEL, type Track, type Type, type Basis } from '../taxonomy';

interface Related { label: string; href: string }
interface Props {
  track: Track;
  type: Type;
  basis?: Basis;
  stage: string;
  updated?: string;
  verified?: string;
  reviewBy?: string;
  related?: Related[];
}
const { track, type, basis, stage, updated, verified, reviewBy, related = [] } = Astro.props;
const t = TRACK_LABEL[track];
const ty = TYPE_LABEL[type];
// 검토 예정일이 지났으면 표시한다(최신성 관리 — strategy/product.md). 빌드 시점 기준.
const overdue = reviewBy ? reviewBy < new Date().toISOString().slice(0, 10) : false;
---

<section class="infobox" aria-label="문서 정보">
  <div class="ib-h">문서 정보</div>
  <dl>
    <dt>트랙</dt><dd>{t.num} {t.ko} <span class="mono">{t.en}</span></dd>
    <dt>유형</dt><dd>{ty.ko} <span class="mono">{ty.en}</span></dd>
    {basis && (
      <>
        <dt>근거</dt>
        <dd>{BASIS_LABEL[basis].ko}<span class="ib-note">{BASIS_LABEL[basis].note}</span></dd>
      </>
    )}
    {related.length > 0 && (
      <>
        <dt>관련 문서</dt>
        <dd>{related.map((r, i) => (<>{i > 0 && ' · '}<a href={r.href}>{r.label}</a></>))}</dd>
      </>
    )}
  </dl>

  {/* 갱신·검증 메타데이터는 접어둔다 — 처음 온 독자에게는 노이즈이고, 필요할 때만 열면 된다.
      단 검토 기한이 지났으면 기본으로 펼쳐 경고가 묻히지 않게 한다. */}
  <details class="ib-more" open={overdue}>
    <summary>갱신·검증 정보{overdue && <span class="stage overdue">기한 경과</span>}</summary>
    <dl>
      {updated && (<><dt>마지막 갱신</dt><dd class="mono">{updated}</dd></>)}
      {verified && (<><dt>사실 확인</dt><dd class="mono">{verified}</dd></>)}
      {reviewBy && (<><dt>검토 예정</dt><dd class="mono">{reviewBy}</dd></>)}
      <dt>성숙도</dt><dd><span class="stage">{stage}</span></dd>
    </dl>
  </details>
</section>
