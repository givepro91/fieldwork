---
import { buildNav, type GuideEntry } from '../nav';
interface Props { entries?: GuideEntry[]; activeId?: string }
const { entries = [], activeId } = Astro.props;
const groups = buildNav(entries);
const activeHref = activeId ? `/guide/${activeId}` : '';
---

<nav class="sidenav" id="sidenav" aria-label="문서 색인">
  {groups.map((g) => {
    // series 로 옮겨진 글도 활성 판정에 포함해야 한다(안 하면 현재 글의 그룹이 접혀 위치를 잃는다).
    const inGroup = [...g.series.flatMap((s) => s.articles), ...g.articles];
    const isActiveGroup = inGroup.some((a) => a.href === activeHref);
    return (
    <details open={isActiveGroup}>
      <summary>
        <span class="chev"></span>
        <span class="grp-t">{g.num} {g.ko}</span>
        <span class="cnt">{g.count}</span>
      </summary>
      <ul>
        {/* series 묶음 먼저 — 제목만으로 주제를 모를 때 도구·주제 이름이 여기서 드러난다 */}
        {g.series.map((s) => (
          <>
            <li class="ser">{s.name}</li>
            {s.articles.map((a) => (
              /* data-s: 검색에서 series 이름으로도 찾히게 한다("obsidian" → 4편) */
              <li class={a.href === activeHref ? 'active' : ''} data-s={s.name}>
                <a href={a.href} title={a.title}><span class="ti">{a.title}</span><span class={a.isDo ? 'badge do' : 'badge'}>{a.typeKo}</span>{a.draft && <span class="badge draft">draft</span>}</a>
              </li>
            ))}
          </>
        ))}
        {g.articles.map((a) => (
          <li class={a.href === activeHref ? 'active' : ''}>
            <a href={a.href} title={a.title}><span class="ti">{a.title}</span><span class={a.isDo ? 'badge do' : 'badge'}>{a.typeKo}</span>{a.draft && <span class="badge draft">draft</span>}</a>
          </li>
        ))}
        {g.planned.map((p) => (
          <li class="soon"><a href="#" title={p}><span class="ti">{p}</span><span class="badge">예정</span></a></li>
        ))}
        {g.series.length === 0 && g.articles.length === 0 && g.planned.length === 0 && <li class="empty">아직 없음</li>}
      </ul>
    </details>
    );
  })}
  <p class="noresult" id="noresult" aria-live="polite">검색 결과 없음</p>
</nav>

<script>
  // 긴 색인에서 현재 글이 보이도록 자동 스크롤(닫힌 그룹 밖이면 무해).
  document.querySelector('.sidenav li.active')?.scrollIntoView({ block: 'nearest' });

  const box = document.getElementById('nav-search') as HTMLInputElement | null;
  if (box) {
    const groups = Array.from(document.querySelectorAll('#sidenav details')) as HTMLDetailsElement[];
    const noresult = document.getElementById('noresult');
    box.addEventListener('input', () => {
      const term = box.value.trim().toLowerCase();
      let hits = 0;
      groups.forEach((g) => {
        let any = false;
        g.querySelectorAll('li').forEach((li) => {
          if (li.classList.contains('empty')) { li.style.display = term ? 'none' : ''; return; }
          // series 헤더는 결과가 아니다 — 검색 중에는 숨기고 항목만 보여준다.
          if (li.classList.contains('ser')) { li.style.display = term ? 'none' : ''; return; }
          // 제목 + series 이름으로 찾는다.
          const hay = `${li.textContent || ''} ${li.dataset.s || ''}`.toLowerCase();
          const match = !term || hay.includes(term);
          li.style.display = match ? '' : 'none';
          if (match) { any = true; hits++; }
        });
        g.style.display = any ? '' : 'none';
        if (term && any) g.open = true;
      });
      if (noresult) noresult.style.display = term && hits === 0 ? 'block' : 'none';
    });
  }
</script>
