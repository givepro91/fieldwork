---
// dev 전용 기획·디자인 시스템 페이지. pages/ 밖에 두고 admin-dev.mjs 가 command==='dev' 일 때만
// injectRoute 하므로 prod 빌드(dist)에 들어가지 않는다.
//
// 원칙: 토큰·콘텐츠 집계·컴포넌트 목록을 이 파일에 하드코딩하지 않는다. 실제 CSS·컬렉션·디렉터리를
// 읽어서 표시한다 — 목업과 구현이 갈라지면 prototype/ 처럼 버려진다.
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
// node:fs 대신 Vite 기능을 쓴다 — @types/node 없이 타입이 잡히고, 경로가 빌드와 같게 해석된다.
import cssText from '../styles/global.css?raw';
import { TRACKS, TYPES, TRACK_LABEL, TYPE_LABEL, ALLOWED_TYPES } from '../taxonomy';
// 구현된 인터랙션은 목업을 다시 만들지 않고 실제 컴포넌트를 그대로 쓴다.
import DecisionTree from '../components/DecisionTree.astro';
import PredictBeforeReveal from '../components/PredictBeforeReveal.astro';

const entries = await getCollection('guide');

// ── 정보 구조: 트랙 × 타입 매트릭스 (실제 집계)
const matrix = TRACKS.map((track) => ({
  track,
  label: TRACK_LABEL[track],
  total: entries.filter((e) => e.data.track === track).length,
  cells: TYPES.map((type) => ({
    type,
    n: entries.filter((e) => e.data.track === track && e.data.type === type).length,
    allowed: ALLOWED_TYPES[track].includes(type),
  })),
}));
const typeTotals = TYPES.map((type) => ({ type, n: entries.filter((e) => e.data.type === type).length }));

// ── 디자인 토큰: global.css 에서 직접 파싱
interface Token { name: string; value: string }
function parseTokens(re: RegExp): Token[] {
  const m = cssText.match(re);
  if (!m) return [];
  return m[1]
    .split(';')
    .map((s: string) => s.trim())
    .filter((s: string) => s.startsWith('--'))
    .map((s: string) => {
      const i = s.indexOf(':');
      return { name: s.slice(0, i).trim(), value: s.slice(i + 1).trim() };
    });
}
const isColor = (v: string) => /^(#|rgb|hsl)/.test(v);
const lightTokens = parseTokens(/:root\s*\{([\s\S]*?)\}/);
const darkTokens = parseTokens(/\.deck\s*\{([\s\S]*?)\}/);
const lightColors = lightTokens.filter((t) => isColor(t.value));
const darkColors = darkTokens.filter((t) => isColor(t.value));
const fontTokens = lightTokens.filter((t) => !isColor(t.value));

// ── 컴포넌트 인벤토리: 실제 파일 목록 + 역할(수기 주석)
const ROLE: Record<string, string> = {
  'Base.astro': '문서 셸 · global.css 로드',
  'Topbar.astro': '상단 바 · 검색 · 발표 진입',
  'SideNav.astro': '좌측 색인 — 트랙 그룹 + 타입 배지',
  'Toc.astro': '우측 목차 · 활성 섹션',
  'Infobox.astro': '문서 정보 — 트랙·유형·최신성',
  'DecisionTree.astro': '선택 트리 — MDX 에서 데이터 주입, noscript 정적 대체',
  'Deck.astro': '발표 오버레이 · 5레이아웃',
  'DrawLayer.astro': '발표 중 필기 레이어',
};
const basename = (p: string) => p.split('/').pop() ?? p;
const existing = [
  ...Object.keys(import.meta.glob('../layouts/*.astro')).map((p) => ({ f: basename(p), dir: 'layouts' })),
  ...Object.keys(import.meta.glob('../components/*.astro')).map((p) => ({ f: basename(p), dir: 'components' })),
];

// 새로 필요한 것 — strategy/product.md 의 인터랙션 3개 + 최신성·산출물 UI
const NEEDED = [
  { name: 'PredictBeforeReveal', why: '설명 전에 예측하게 한다 (레슨 필수 1번)', type: 'concept·decision', prio: 1 },
  { name: 'Compare', why: '축별 비교를 한 화면에 — 지금은 글마다 손수 표', type: 'decision', prio: 1 },
  { name: 'VerifiedBadge', why: 'verified·review_by 를 본문 상단에 노출 (지금은 인포박스에만)', type: '전 타입', prio: 2 },
  { name: 'ArtifactDownload', why: 'Template 타입의 산출물을 실제로 받아가게', type: 'template', prio: 2 },
  { name: 'TrackCard', why: '트랙 진입·진행 상태(localStorage)', type: '탐색', prio: 3 },
];

const today = new Date().toISOString().slice(0, 10);
---

<Base title="기획 · 디자인 시스템 (dev)">
  <div class="dv-top">
    <b>기획 · 디자인 시스템</b>
    <span class="dv-tag">dev 전용 · prod 빌드 제외</span>
    <nav class="dv-nav">
      <a href="#s1">제품 정의</a>
      <a href="#s2">정보 구조</a>
      <a href="#s3">토큰</a>
      <a href="#s4">컴포넌트</a>
      <a href="#s5">인터랙션</a>
    </nav>
  </div>

  <div class="dv-wrap">
    <!-- ───────────────────────── 1. 제품 정의 ───────────────────────── -->
    <section id="s1" class="dv-sec">
      <p class="dv-h">01 · 제품 정의</p>
      <p class="dv-thesis">전 범위를 가르치는 곳이 아니라,<br />끝까지 갈 수 있는 <em>하나의 경로</em>를 주는 곳.</p>
      <div class="dv-grid3">
        <div class="dv-card">
          <p class="dv-ct">세 요소의 결합</p>
          <ul class="dv-ul">
            <li><b>판단</b> — 무엇을 고를지, 왜 그걸 골랐는지</li>
            <li><b>경로</b> — 처음부터 운영까지 통과할 순서</li>
            <li><b>산출물</b> — 끝내면 자기 레포에 남는 것</li>
          </ul>
        </div>
        <div class="dv-card">
          <p class="dv-ct">독자 우선순위</p>
          <ol class="dv-ol">
            <li>미래의 나</li>
            <li>판단력을 보는 사람 (채용·협업)</li>
            <li>같은 경로를 걸으려는 실무자</li>
          </ol>
          <p class="dv-note">①②를 잃으면서 ③을 늘리는 결정은 하지 않는다.</p>
        </div>
        <div class="dv-card dv-card-hi">
          <p class="dv-ct">핵심 제약</p>
          <p class="dv-cb"><b>해본 것처럼 쓰지 않는다.</b></p>
          <p class="dv-note">경험은 근거의 한 종류이고 필수가 아니다. 조사·정리로도 쓰되 근거를 <code>basis</code> 로 밝힌다(2026-07-26 정정 — 원칙을 스키마로 막았더니 가장 알고 싶은 트랙이 통째로 막혔다). 커버리지를 포기하고 완주 가능성을 택한 건 그대로다.</p>
        </div>
      </div>

      <p class="dv-ct dv-mt">단계 게이트 — 정적 배포를 언제 포기하나</p>
      <ol class="dv-gates">
        <li class="on">
          <span class="g-n">1</span>
          <div><b>콘텐츠 모델 · 인터랙션 3개 · 최신성 · Template</b><i>비용 0 · 지금 여기</i></div>
        </li>
        <li><span class="g-n">2</span><div><b>브라우저 실습 (Sandpack)</b><i>비용 0 · 꼭 필요한 레슨이 생겼을 때</i></div></li>
        <li><span class="g-n">3</span><div><b>계정 · 진도 동기화</b><i>서버 · 완주한 사용자가 생겼을 때</i></div></li>
        <li><span class="g-n">4</span><div><b>원격 샌드박스 실습</b><i>시간당 과금 · 3단계 사용자가 요구 + 상한 설계 후</i></div></li>
        <li><span class="g-n">5</span><div><b>AI 미디어</b><i>API 과금 · 그림으로 안 되는 레슨이 나왔을 때</i></div></li>
      </ol>
    </section>

    <!-- ───────────────────────── 2. 정보 구조 ───────────────────────── -->
    <section id="s2" class="dv-sec">
      <p class="dv-h">02 · 정보 구조</p>
      <p class="dv-lead">
        분류 2축 — <b>트랙</b>(어느 영역) × <b>타입</b>(어떤 성격). 아래는 지금 {entries.length}편의 실제 분포다.{' '}
        <b>빈 칸이 곧 다음 할 일</b>이고, 잠긴 칸은 스키마가 막는다.
      </p>

      <div class="dv-matrix-wrap">
        <table class="dv-matrix">
          <thead>
            <tr>
              <th class="rh">트랙 \ 타입</th>
              {TYPES.map((t) => (<th>{TYPE_LABEL[t].ko}<i>{TYPE_LABEL[t].en}</i></th>))}
              <th class="tot">합</th>
            </tr>
          </thead>
          <tbody>
            {matrix.map((row) => (
              <tr>
                <th class="rh">
                  <b>{row.label.num} {row.label.ko}</b>
                  <i>{row.label.en}</i>
                </th>
                {row.cells.map((c) => (
                  <td class={!c.allowed ? 'locked' : c.n > 0 ? 'has' : 'zero'}>
                    {c.allowed ? (c.n > 0 ? c.n : '·') : <span title="스키마가 막는 조합">🔒</span>}
                  </td>
                ))}
                <td class="tot">{row.total || '·'}</td>
              </tr>
            ))}
            <tr class="foot">
              <th class="rh">합</th>
              {typeTotals.map((t) => (<td class={t.n > 0 ? 'has' : 'zero'}>{t.n || '·'}</td>))}
              <td class="tot">{entries.length}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="dv-grid2 dv-mt">
        <div class="dv-card">
          <p class="dv-ct">읽히는 것</p>
          <ul class="dv-ul">
            <li><b>template · log 가 0</b> — 복사해 쓸 산출물과 실패 기록이 없다. 이 제품에서 가장 차별적인 두 타입.</li>
            <li><b>③④⑤ 트랙이 0</b> — ④는 이 레포를 만든 과정이 그대로 재료다.</li>
            <li><b>⑤는 기록만 허용</b> — 아직 제대로 못 쓰고 있어서. 승급 조건은 그 구조로 프로젝트 하나를 끝냈을 때.</li>
          </ul>
        </div>
        <div class="dv-card">
          <p class="dv-ct">레슨 필수 4요소</p>
          <ol class="dv-ol">
            <li>독자가 먼저 선택·예측하는 지점 1회</li>
            <li>시각 요소 최소 1개</li>
            <li>검증 가능한 완료 조건</li>
            <li>출처와 검증일 (외부 사실이 있을 때)</li>
          </ol>
        </div>
      </div>
    </section>

    <!-- ───────────────────────── 3. 디자인 토큰 ───────────────────────── -->
    <section id="s3" class="dv-sec">
      <p class="dv-h">03 · 디자인 토큰</p>
      <p class="dv-lead">
        <code>src/styles/global.css</code> 에서 파싱한 실제 값이다. 이 페이지는 값을 복제하지 않는다 —
        CSS 를 고치면 여기도 바뀐다.
      </p>

      <p class="dv-ct">라이트 · 위키 <span class="dv-src">:root</span></p>
      <div class="dv-swatches">
        {lightColors.map((t) => (
          <div class="sw">
            <div class="sw-c" style={`background:${t.value}`}></div>
            <b>{t.name}</b>
            <i>{t.value}</i>
          </div>
        ))}
      </div>

      <p class="dv-ct dv-mt">다크 · 발표 <span class="dv-src">.deck</span></p>
      <div class="dv-swatches on-dark">
        {darkColors.map((t) => (
          <div class="sw">
            <div class="sw-c" style={`background:${t.value}`}></div>
            <b>{t.name}</b>
            <i>{t.value}</i>
          </div>
        ))}
      </div>

      <p class="dv-ct dv-mt">타이포</p>
      <div class="dv-grid2">
        {fontTokens.map((t) => (
          <div class="dv-card">
            <p class="dv-ct">{t.name}</p>
            <p class={t.name === '--mono' ? 'dv-type mono' : 'dv-type'}>판단 기준을 쌓는다 · AaBb 0123</p>
            <p class="dv-note dv-break">{t.value}</p>
          </div>
        ))}
      </div>

      <p class="dv-ct dv-mt">라운드 · 섀도 · 위계 (현재 사용 중인 값)</p>
      <div class="dv-shapes">
        <div class="shp" style="border-radius:8px">8 <i>배지·버튼</i></div>
        <div class="shp" style="border-radius:12px">12 <i>카드·비교</i></div>
        <div class="shp" style="border-radius:14px">14 <i>인포박스·랜딩 카드</i></div>
        <div class="shp" style="border-radius:999px">999 <i>pill·CTA</i></div>
        <div class="shp sh1">soft <i>0 1px 2px</i></div>
        <div class="shp sh2">lift <i>0 4px 16px</i></div>
      </div>
      <p class="dv-note">
        <b>해결됨</b> — 경고색이 네 곳(기한 경과 배지 · DecisionTree 보류 결론 · 이 페이지의 dev 태그 ·
        admin 경과 pill)에 하드코딩돼 있던 것을 <code>--warn / --warn-bg / --warn-bd</code> 로 묶었다.
        <code>--ok-*</code> 와 짝이고, "멈춰 세우는" 표시에만 쓴다. 발표(다크)에는 아직 경고 표시가 없어 넣지 않았다.
      </p>
    </section>

    <!-- ───────────────────────── 4. 컴포넌트 인벤토리 ───────────────────────── -->
    <section id="s4" class="dv-sec">
      <p class="dv-h">04 · 컴포넌트 인벤토리</p>

      <p class="dv-ct">지금 있는 것 <span class="dv-src">{existing.length}개</span></p>
      <div class="dv-inv">
        {existing.map((x) => (
          <div class="inv">
            <b>{x.f.replace('.astro', '')}</b>
            <i>{ROLE[x.f] || '—'}</i>
            <span class="inv-p">src/{x.dir}/</span>
          </div>
        ))}
      </div>

      <p class="dv-ct dv-mt">실물 — 아래는 사이트와 같은 클래스로 렌더된 것</p>
      <div class="dv-grid2 start">
        <div class="dv-card">
          <p class="dv-ct">배지 · 상태</p>
          <div class="dv-row">
            <span class="dv-badge">개념</span>
            <span class="dv-badge">선택</span>
            <span class="dv-badge">플레이북</span>
            <span class="dv-badge">템플릿</span>
            <span class="dv-badge">기록</span>
          </div>
          <div class="dv-row dv-mt-s">
            <span class="stage">탐색 중</span>
            <span class="stage overdue">기한 경과</span>
          </div>
          <p class="dv-note">타입 배지는 색이 전부 같다 — 5타입을 구분하려면 색 또는 형태가 필요하다. <b>결정 대기.</b></p>
        </div>
        <div class="dv-card">
          <p class="dv-ct">인포박스 (오늘 {today} 기준 기한 경과 데모)</p>
          <section class="infobox" aria-label="예시">
            <div class="ib-h">문서 정보</div>
            <dl>
              <dt>트랙</dt><dd>① 에이전트로 일하기 <span class="mono">Agents</span></dd>
              <dt>유형</dt><dd>선택 <span class="mono">Decision</span></dd>
              <dt>사실 확인</dt><dd class="mono">2026-06-23</dd>
              <dt>검토 예정</dt><dd class="mono">2026-07-01<span class="stage overdue">기한 경과</span></dd>
            </dl>
          </section>
        </div>
      </div>

      <div class="dv-mt">
        <p class="dv-ct">본문 도식 — thesis · compare · stack</p>
        <!-- thesis 는 .prose 하위 선택자로만 스타일이 있어 래퍼가 필요하다 (사이트와 동일 조건) -->
        <div class="prose">
          <blockquote class="thesis" style="max-width:none">에이전트를 잘 쓴다는 건 프롬프트를 더 잘 쓰는 일이 아니라, 환경을 설계하고 그 환경을 사람 없이 돌게 만드는 일이다.</blockquote>
        </div>
        <div class="compare">
          <div class="cmp-card">
            <p class="cmp-h">읽고 끝나는 문서</p>
            <ul><li>설명 → 이해</li><li>남는 것: 없음</li><li>검증: 불가</li></ul>
          </div>
          <div class="cmp-arrow">→</div>
          <div class="cmp-card is-ax">
            <p class="cmp-h">경로형 콘텐츠</p>
            <ul><li>선택 → 실행 → 검증</li><li>남는 것: 산출물</li><li>검증: 완료 조건</li></ul>
          </div>
        </div>
        <div class="stack" style="margin-top:14px">
          <div class="layer l1"><span class="ln">01</span><span class="lt">Concept</span><span class="desc">개념을 시각적으로</span></div>
          <div class="layer l2"><span class="ln">02</span><span class="lt">Decision</span><span class="desc">선택 기준과 트레이드오프</span></div>
          <div class="layer l3"><span class="ln">03</span><span class="lt">Playbook</span><span class="desc">단계별 실행 절차</span></div>
          <div class="layer l4"><span class="ln">04</span><span class="lt">Template</span><span class="desc">복사해 쓰는 산출물</span></div>
          <div class="layer l5"><span class="ln">05</span><span class="lt">Log</span><span class="desc">접은 기록·실패</span></div>
        </div>
      </div>

      <p class="dv-ct dv-mt">새로 필요한 것</p>
      <div class="dv-inv">
        {NEEDED.map((n) => (
          <div class={`inv need p${n.prio}`}>
            <b>{n.name}</b>
            <i>{n.why}</i>
            <span class="inv-p">{n.type} · 우선순위 {n.prio}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- ───────────────────────── 5. 인터랙션 목업 ───────────────────────── -->
    <section id="s5" class="dv-sec">
      <p class="dv-h">05 · 인터랙션</p>
      <p class="dv-lead">
        아래 둘은 목업이 아니라 <b>실제 컴포넌트</b>다 — 콘텐츠가 쓰는 것과 같은 파일을 렌더한다.
        데이터는 MDX 에서 주입하므로 컴포넌트에 내용이 박히지 않는다.
      </p>

      <!-- DecisionTree — 목업이 아니라 실제 컴포넌트. cc-vs-codex 가 쓰는 것과 같은 파일이다. -->
      <div class="dv-mock">
