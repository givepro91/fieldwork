<script>
  // ── DecisionTree: 스텝 전환 (데이터는 DOM 의 data-step / data-go 로 — 컴포넌트화 시 JSON 으로 뺀다)
  const tree = document.getElementById('tree');
  const treeReset = document.getElementById('tree-reset');
  const show = (key: string) => {
    tree?.querySelectorAll<HTMLElement>('[data-step]').forEach((el) => {
      el.hidden = el.dataset.step !== key;
    });
    if (treeReset) treeReset.hidden = key === '0';
  };
  tree?.querySelectorAll<HTMLButtonElement>('.tr-o').forEach((b) => {
    b.addEventListener('click', () => show(b.dataset.go || '0'));
  });
  treeReset?.addEventListener('click', () => show('0'));

  // ── PredictBeforeReveal: 고른 뒤에만 공개
  const predOpts = document.querySelectorAll<HTMLButtonElement>('#pred .pd-o');
  const predRev = document.getElementById('pd-rev');
  predOpts.forEach((b) => {
    b.setAttribute('aria-pressed', 'false');
    b.addEventListener('click', () => {
      predOpts.forEach((o) => {
        o.setAttribute('aria-pressed', String(o === b));
        o.classList.toggle('is-key', o.dataset.k === 'b');
      });
      if (predRev) predRev.hidden = false;
    });
  });

  // ── Compare: 축 필터
  const cmp = document.getElementById('cmp');
  cmp?.querySelectorAll<HTMLButtonElement>('.cp-ax').forEach((b) => {
    b.addEventListener('click', () => {
      cmp.querySelectorAll('.cp-ax').forEach((x) => x.classList.toggle('on', x === b));
      const ax = b.dataset.ax;
      cmp.querySelectorAll<HTMLElement>('.cp-t tbody tr').forEach((tr) => {
        tr.hidden = ax !== 'all' && tr.dataset.ax !== ax;
      });
    });
  });
</script>
